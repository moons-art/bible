rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ------------------------------------------------------------------------
    // 1. 사용자 데이터 및 개인 서브컬렉션 (설교노트, 구절메모, AI주석)
    // ------------------------------------------------------------------------
    match /users/{userId} {
      // 사용자 프로필 문서 읽기/쓰기 허용 (클라이언트 호환성 및 관리자 조회 유지)
      allow read, write: if true;

      // 설교 노트
      match /sermons/{sermonId} {
        allow read, write: if true;
      }

      // 성경 구절 메모 및 형광펜 하이라이트
      match /verseData/{verseId} {
        allow read, write: if true;
      }

      // 생성된 AI 주석 캐시
      match /cloudCommentaries/{commentaryId} {
        allow read, write: if true;
      }

      // 기타 사용자 하위 컬렉션 호환
      match /{subCollection}/{docId} {
        allow read, write: if true;
      }
    }

    // ------------------------------------------------------------------------
    // 2. 서비스 정책 및 전역 시스템 설정 (FAQ, 플랜 설정, 프로모션 등)
    // ------------------------------------------------------------------------
    match /settings/{docId} {
      allow read, write: if true;
    }

    match /system_settings/{docId} {
      allow read, write: if true;
    }

    // ------------------------------------------------------------------------
    // 3. 시스템 사용량 및 통계 지표 (일별/월별)
    // ------------------------------------------------------------------------
    match /system_metrics/{docId} {
      allow read, write: if true;
    }

    match /system_metrics_monthly/{docId} {
      allow read, write: if true;
    }

    // ------------------------------------------------------------------------
    // 4. 친구 추천 프로모션 요청
    // ------------------------------------------------------------------------
    match /referral_requests/{docId} {
      allow read, write: if true;
    }

    // ------------------------------------------------------------------------
    // 5. 활동 감사 로그 (activity_logs)
    // - 작성 및 조회/삭제는 허용하되, 기존 로그의 '내용 변조(update)'는 원천 차단
    // ------------------------------------------------------------------------
    match /activity_logs/{logId} {
      allow read, create, delete: if true;
      allow update: if false; // 로그 위변조 차단 (무결성 보장)
    }

    // ------------------------------------------------------------------------
    // 6. 기본 거부 규칙 (위에서 명시적으로 허용된 정상 경로 외에는 전면 차단)
    // ------------------------------------------------------------------------
    // Firestore는 일치하는 규칙이 없으면 기본적으로 모든 접근을 거부(Deny by default)합니다.
  }
}
